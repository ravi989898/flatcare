<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # One canonical origin (https://flatcare.in): send www.flatcare.in and plain
    # http to it with a single 301, so Google never sees duplicate hosts.
    # Only applies to the production host names, so localhost / staging still work,
    # and honours X-Forwarded-Proto when TLS is terminated by a proxy/CDN.
    RewriteCond %{HTTP_HOST} ^www\.flatcare\.in$ [NC]
    RewriteRule ^ https://flatcare.in%{REQUEST_URI} [L,R=301]
    RewriteCond %{HTTP_HOST} ^flatcare\.in$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://flatcare.in%{REQUEST_URI} [L,R=301]

    # Never serve dot-files/directories (.env, .git, .htpasswd, ...), except
    # the RFC 8615 .well-known folder used for certificate validation.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Uploaded files live under /storage (a symlink to storage/app/public).
    # They must only ever be downloaded/displayed, never executed or rendered
    # as a page: refuse anything with a server-side-script or HTML/JS
    # extension, whatever a user managed to name it.
    RewriteRule ^storage/.*\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp|exe|dll|bat|cmd|html?|xhtml|js|mjs)$ - [F,NC,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Files under /storage bypass Laravel (Apache serves them directly), so the
# SecurityHeaders middleware never runs for them: give them the headers here.
# `sandbox` + `default-src 'none'` means even an SVG opened directly in the
# browser cannot run script or load anything.
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/storage/#">
        Header always set X-Content-Type-Options "nosniff"
        Header always set Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox"
    </If>
    Header always unset X-Powered-By
</IfModule>
