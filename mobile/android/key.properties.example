# The real key.properties (git-ignored) sits next to this file and points at
# app/upload-keystore.jks (also git-ignored): the FlatCare release key, used
# for the Play Store bundle (build-aab.ps1) and the website APK
# (build-apk.ps1). Keep a backup of BOTH files somewhere safe - losing them
# means you can never ship an update to installed apps.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=flatcare
keyPassword=CHANGE_ME
