<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability (visitor alerts, bills, notices via
	     Firebase Cloud Messaging). Xcode/App Store signing switches this to
	     "production" for TestFlight and App Store builds automatically. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
